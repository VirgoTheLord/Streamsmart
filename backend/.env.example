# ────────────────────────────────────────────────
# StreamSmart Backend — Environment Variables
# Copy to .env and fill in your values.
# NEVER commit .env to version control.
# ────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.3gpokfu.mongodb.net/streamsmart?retryWrites=true&w=majority&appName=Cluster0

# JWT — generate a strong secret: `openssl rand -hex 64`
JWT_SECRET=change_me_to_a_strong_random_secret
JWT_EXPIRES_IN=7d

# Cookie
COOKIE_DOMAIN=localhost

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000
